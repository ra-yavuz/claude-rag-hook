#!/usr/bin/env python3
# claude-rag-hook entrypoint.
#
# Provided as is, no warranty. RAG retrieves text from local files and
# sends it to Anthropic when retrieval triggers. Audit what you index.
# Full text in README and on https://ra-yavuz.github.io/claude-rag-hook/.

import os
import sys


def _bootstrap_sys_path() -> None:
    """Make sure lib/ is importable when this script runs uninstalled.

    When installed via `pip install` or apt, the package is on sys.path
    already and this is a no-op. When run from the repo (./bin/claude-rag-hook),
    we add ../lib so the import below works.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    lib_local = os.path.normpath(os.path.join(here, "..", "lib"))
    lib_apt = "/usr/lib/claude-rag-hook"
    for candidate in (lib_local, lib_apt):
        if os.path.isdir(os.path.join(candidate, "claude_rag_hook")) and candidate not in sys.path:
            sys.path.insert(0, candidate)


_bootstrap_sys_path()

from claude_rag_hook.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
