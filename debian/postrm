#!/bin/sh
# postrm for claude-rag-hook
set -e

case "$1" in
    purge)
        # The package itself ships nothing under /var or /etc. Per-user
        # data lives under $XDG_CONFIG_HOME/claude-rag-hook,
        # $XDG_CACHE_HOME/claude-rag-hook, $XDG_STATE_HOME/claude-rag-hook,
        # and inside each indexed folder as .claude-rag-index/. We do
        # NOT touch user-owned data on purge: the user runs the index;
        # the user owns the index. Removing it on purge would be a
        # surprise.
        :
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
